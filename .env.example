# Database Configuration
DATABASE_LINK="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority"

# Email Configuration (SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# Environment
NODE_ENV="development"
ADMIN_PIN="1234"

# Vercel Deployment Hook (optional)
VERCEL_DEPLOY_HOOK="your-vercel-deploy-hook"

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Redis / Upstash KV Configuration
KV_REST_API_READ_ONLY_TOKEN="your-kv-read-only-token"
KV_REST_API_TOKEN="your-kv-write-token"
KV_REST_API_URL="https://your-database-id.upstash.io"
KV_URL="rediss://default:your-kv-token@your-database-id.upstash.io:6379"
REDIS_URL="rediss://default:your-kv-token@your-database-id.upstash.io:6379"
